{
  "name": "neiwang-xiaozhi-development",
  "version": "0.1.0",
  "private": true,
  "description": "内网小智开发版构建入口",
  "engines": {
    "node": ">=24.9.0 <25"
  },
  "scripts": {
    "prepare:runtime": "node scripts/prepare-dev.cjs",
    "prepare:plugins": "node --use-env-proxy scripts/prepare-offline-plugins.cjs",
    "build": "node scripts/build-dev.cjs",
    "start": "node scripts/start-dev.cjs",
    "package": "node scripts/package-dev.cjs",
    "check": "node scripts/python-dev.cjs check_source.py",
    "test:runtime": "node scripts/python-dev.cjs test_runtime_prepare.py",
    "test": "node --test scripts/test-dev.cjs scripts/test-release-config.cjs scripts/test-feature-boot.cjs scripts/test-business-config.cjs scripts/test-browser-patch.cjs scripts/test-python-runtime.cjs scripts/test-browser-url-patch.cjs",
    "test:plugins": "node --test scripts/test-plugin-manager.cjs scripts/test-dev.cjs",
    "verify:app": "node scripts/verify-dev-app.cjs"
  },
  "dependencies": {
    "@deepseek-ai/dsh": "0.2.1-rc.3",
    "@dingtalk-real-ai/dsh-dingtalk": "0.10.2"
  },
  "devDependencies": {
    "electron": "33.2.0"
  }
}
